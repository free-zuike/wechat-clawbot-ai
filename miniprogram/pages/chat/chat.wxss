.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #FFF0F5 0%, #E0F0FF 100%);
}

.chat-header {
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 2rpx solid #FFE0EC;
}

.avatar-bot {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #FF6B9D, #FF8C5A);
  border-radius: 50%;
  text-align: center;
  line-height: 80rpx;
  font-size: 44rpx;
}

.bot-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4D8D;
}

.bot-status {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.chat-messages {
  flex: 1;
  padding: 24rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-end;
  gap: 12rpx;
}

.msg-row.is-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 60rpx;
  height: 60rpx;
  background: #FFFFFF;
  border-radius: 50%;
  text-align: center;
  line-height: 60rpx;
  font-size: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  flex-shrink: 0;
}

.msg-bubble {
  max-width: 70%;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.is-bot .msg-bubble {
  background: #FFFFFF;
  color: #333333;
  border-bottom-left-radius: 8rpx;
}

.is-user .msg-bubble {
  background: linear-gradient(135deg, #FF6B9D, #FF8C5A);
  color: #FFFFFF;
  border-bottom-right-radius: 8rpx;
}

.msg-bubble.typing {
  background: #FFFFFF;
  color: #FF6B9D;
  font-size: 40rpx;
  padding: 20rpx 28rpx;
}

.dot {
  animation: bounce 1.2s infinite;
  display: inline-block;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.3; }
  40% { transform: translateY(-8rpx); opacity: 1; }
}

.chat-input {
  display: flex;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #FFE0EC;
  gap: 16rpx;
}

.input-box {
  flex: 1;
  background: #FFF0F5;
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
  font-size: 30rpx;
}

.send-btn {
  background: linear-gradient(135deg, #FF6B9D, #FF8C5A);
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  line-height: 1.5;
  border: none;
  margin: 0;
}

.send-btn::after {
  border: none;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 24rpx 24rpx;
  background: #FFFFFF;
}

.quick-chip {
  background: #FFF0F5;
  color: #FF6B9D;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  border: 2rpx solid #FFE0EC;
}
