<view class="container">
  <view class="user-card">
    <view class="user-avatar">🧸</view>
    <view class="user-info">
      <view class="user-name">爪爪玩家</view>
      <view class="user-level">{{levelText}}</view>
    </view>
    <view class="points-badge">⭐ {{points}}</view>
  </view>

  <view class="stats-row">
    <view class="stat-box">
      <view class="stat-emoji">🎁</view>
      <view class="stat-value">{{giftCount}}</view>
      <view class="stat-key">娃娃数量</view>
    </view>
    <view class="stat-box">
      <view class="stat-emoji">🎮</view>
      <view class="stat-value">{{plays}}</view>
      <view class="stat-key">夹取次数</view>
    </view>
    <view class="stat-box">
      <view class="stat-emoji">✨</view>
      <view class="stat-value">{{rareCount}}</view>
      <view class="stat-key">稀有以上</view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">🎀 我的战利品</view>
    <view wx:if="{{collectedGifts.length === 0}}" class="empty">
      <view class="empty-emoji">🎐</view>
      <view class="empty-text">还没有抓到娃娃哦</view>
      <view class="empty-tip">快去夹娃娃页面试试手气吧!</view>
    </view>
    <view wx:else class="gift-grid">
      <view wx:for="{{collectedGifts}}" wx:key="time" class="gift-item rarity-{{item.rarity}}">
        <view class="gift-emoji">{{item.emoji}}</view>
        <view class="gift-name">{{item.name}}</view>
        <view class="gift-points">+{{item.points}}</view>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">🏅 成就等级</view>
    <view class="level-bar">
      <view class="level-progress" style="width: {{progressPercent}}%"></view>
    </view>
    <view class="level-info">当前: {{levelText}} · 下一等级还需 {{nextLevel}} 积分</view>
  </view>
</view>
