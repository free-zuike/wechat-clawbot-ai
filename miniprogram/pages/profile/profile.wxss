.user-card {
  background: linear-gradient(135deg, #FF6B9D, #FF8C5A);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.3);
  margin-top: 24rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  text-align: center;
  line-height: 120rpx;
  font-size: 64rpx;
  border: 4rpx solid rgba(255,255,255,0.5);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
}

.user-level {
  font-size: 26rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

.points-badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat-box {
  flex: 1;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.stat-emoji {
  font-size: 40rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF4D8D;
  margin-top: 8rpx;
}

.stat-key {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF4D8D;
  margin-bottom: 24rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 32rpx;
}

.empty-emoji {
  font-size: 120rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-top: 16rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #BBB;
  margin-top: 8rpx;
}

.gift-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.gift-item {
  width: calc((100% - 48rpx) / 3);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.gift-item.rarity-rare {
  background: linear-gradient(135deg, #FFF0F5, #E0F0FF);
  border: 2rpx solid #FFB6C8;
}

.gift-item.rarity-legendary {
  background: linear-gradient(135deg, #FFF4A3, #FFB3D9);
  border: 2rpx solid #FFD700;
  box-shadow: 0 4rpx 16rpx rgba(255,215,0,0.3);
}

.gift-emoji {
  font-size: 56rpx;
}

.gift-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 8rpx;
  font-weight: 500;
}

.gift-points {
  font-size: 22rpx;
  color: #FF6B9D;
  margin-top: 4rpx;
  font-weight: bold;
}

.level-bar {
  height: 20rpx;
  background: #FFE0EC;
  border-radius: 20rpx;
  overflow: hidden;
}

.level-progress {
  height: 100%;
  background: linear-gradient(90deg, #FF6B9D, #FF8C5A);
  border-radius: 20rpx;
  transition: width 0.5s;
}

.level-info {
  text-align: center;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #888;
}
