/* app.wxss - 全局样式 */
page {
  background: linear-gradient(135deg, #FFE0EC 0%, #E0F0FF 50%, #F0E0FF 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  min-height: 100vh;
}

.container {
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 157, 0.15);
  backdrop-filter: blur(10px);
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B9D, #FF8C5A);
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 24rpx;
  font-size: 32rpx;
  text-align: center;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.3);
  border: none;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.9);
  color: #FF6B9D;
  border-radius: 48rpx;
  padding: 24rpx;
  font-size: 32rpx;
  text-align: center;
  font-weight: bold;
  border: 2rpx solid #FFB6C8;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF4D8D;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666666;
}

.text-accent {
  color: #FF6B9D;
  font-weight: bold;
}
